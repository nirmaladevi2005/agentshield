# ==============================================================================
# AgentShield Root .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
*.env
**/.env
**/*.env
!.env.example
!**/.env.example

# Local SQLite databases & data persistence
*.db
*.sqlite
*.sqlite3
agentshield.db
backend/agentshield.db

# Python virtual environments & packages
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Testing & code quality caches
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend dependencies and build outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.tsbuildinfo

# Logs & temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
