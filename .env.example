# ==============================================================================
# AgentShield Environment Configuration Template
# Copy this file to .env and configure for your environment
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PORT=8000

# Security & Authentication
SECRET_KEY=agentshield_secure_super_secret_key_change_in_prod_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Zero-Config Engine (Default):
DATABASE_URL=sqlite:///./agentshield.db
# Production Managed PostgreSQL Engine (Uncomment for Cloud Run / Cloud SQL):
# DATABASE_URL=postgresql://agentshield_user:StrongPassword123@10.0.0.1:5432/agentshield_prod

# Google Gemini API Configuration (Advisory Vulnerability Intelligence)
# Leave blank to use built-in offline deterministic fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins:
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend URL
FRONTEND_URL=http://localhost:5173
